{
  "rules": {
    ".read": false,
    ".write": false,
    "advisorQuiz": {
      "config": {
        ".read": true,
        ".write": "auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists()"
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "receipts": {
        "$id": {
          ".read": true,
          ".write": "!data.exists()",
          ".validate": "newData.val() === true"
        }
      },
      "stats": {
        "$v": {
          ".read": true,
          "$metric": {
            "$bucket": {
              ".write": "newData.exists()",
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            }
          }
        }
      },
      "funnel": {
        ".read": "auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists()",
        "$v": {
          "$source": {
            "$stage": {
              ".write": "newData.exists()",
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $source.length <= 40"
            }
          }
        }
      },
      "plays": {
        ".read": "auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists()",
        "$v": {
          "$id": {
            ".write": "!data.exists() || (auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists() && !newData.exists())",
            ".validate": "newData.hasChildren(['t', 'type', 'spec']) && newData.child('t').val() === now && newData.child('type').isString() && newData.child('type').val().length <= 20 && newData.child('spec').isString() && newData.child('spec').val().length <= 20"
          }
        }
      },
      "leads": {
        ".read": "auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists()",
        "$id": {
          ".write": "!data.exists() || (auth != null && root.child('advisorQuiz/admins/' + auth.uid).exists() && !newData.exists())",
          ".validate": "newData.hasChildren(['t', 'stage', 'name', 'email', 'consent']) && newData.child('t').val() === now && newData.child('name').val().length <= 60 && newData.child('email').val().length <= 254 && newData.child('email').val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/) && newData.child('consent/email').val() === true && (newData.child('stage').val() === 'curious' || newData.child('stage').val() === 'considering' || newData.child('stage').val() === 'advisor')"
        }
      }
    }
  }
}